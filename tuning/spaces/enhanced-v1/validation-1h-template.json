  "fee_bps": 5,
  "slippage_bps": 2,
  "baseline": {
    "schema_version": 5,
    "classic": {
      "algorithm": "original-online",
      "source": "close",
      "neighbors": 8,
      "max_bars_back": 2000,
      "feature_count": 5,
      "features": [
        {
          "name": "RSI",
          "a": 14,
          "b": 1
        },
        {
          "name": "WT",
          "a": 10,
          "b": 11
        },
        {
          "name": "CCI",
          "a": 20,
          "b": 1
        },
        {
          "name": "ADX",
          "a": 20,
          "b": 1
        },
        {
          "name": "RSI",
          "a": 9,
          "b": 1
        }
      ],
      "include_full_history": false,
      "use_volatility_filter": true,
      "use_regime_filter": true,
      "use_adx_filter": false,
