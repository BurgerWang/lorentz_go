      "feature_group": {
        "name": "classic",
        "features": [
          {
            "name": "RSI",
            "a": 14,
            "b": 1,
            "normalization": "legacy",
            "window": 0
          },
          {
            "name": "WT",
            "a": 10,
            "b": 11,
            "normalization": "legacy",
            "window": 0
          },
          {
            "name": "CCI",
            "a": 20,
            "b": 1,
            "normalization": "legacy",
            "window": 0
          },
          {
            "name": "ADX",
            "a": 20,
            "b": 1,
            "normalization": "legacy",
            "window": 0
          },
          {
            "name": "RSI",
            "a": 9,
            "b": 1,
            "normalization": "legacy",
            "window": 0
          }
        ]
      }
    },
    "exit": {
