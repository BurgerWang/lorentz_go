        "daily": {
          "enabled": false,
          "h": 8,
          "r": 8,
          "x": 25,
          "history_start": "2020-01-01"
        },
        "entry_mode": "main",
        "pullback": {
          "enabled": false,
          "max_wait_bars": 24
        },
        "classifier": {
          "family": "classic-extended",
          "feature_group": {
            "name": "classic",
            "features": [
              {
                "name": "RSI",
                "a": 14,
                "b": 1,
                "normalization": "legacy",
                "window": 0
              },
              {
                "name": "WT",
                "a": 10,
                "b": 11,
                "normalization": "legacy",
                "window": 0
              },
              {
                "name": "CCI",
                "a": 20,
                "b": 1,
                "normalization": "legacy",
                "window": 0
              },
              {
                "name": "ADX",
                "a": 20,
                "b": 1,
                "normalization": "legacy",
                "window": 0
              },
              {
                "name": "RSI",
                "a": 9,
                "b": 1,
                "normalization": "legacy",
                "window": 0
              }
            ]
          }
        },
        "exit": {
