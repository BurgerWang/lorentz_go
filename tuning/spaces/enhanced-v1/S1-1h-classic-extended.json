  "data_use": "development",
  "seeds": [
    {
      "name": "default-classic",
      "config": {
        "schema_version": 5,
        "classic": {
          "algorithm": "original-online",
          "source": "close",
          "neighbors": 8,
          "max_bars_back": 2000,
          "feature_count": 5,
          "features": [
            {
              "name": "RSI",
              "a": 14,
              "b": 1
            },
            {
              "name": "WT",
              "a": 10,
              "b": 11
            },
            {
              "name": "CCI",
              "a": 20,
              "b": 1
            },
            {
              "name": "ADX",
              "a": 20,
              "b": 1
            },
            {
              "name": "RSI",
              "a": 9,
              "b": 1
            }
          ],
          "include_full_history": false,
          "use_volatility_filter": true,
          "use_regime_filter": true,
          "use_adx_filter": false,
          "regime_threshold": -0.1,
          "adx_threshold": 20,
          "use_ema_filter": false,
          "ema_period": 200,
          "use_sma_filter": false,
